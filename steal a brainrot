-- ── EXECUTE ──────────────────────────────────────────────────────────────────
local function safeExec(src)
    local ok, err = pcall(loadstring(src))
    if ok then
        StatusLabel.Text = "✓ executed"
        StatusLabel.TextColor3 = Color3.fromRGB(80, 220, 100)
    else
        StatusLabel.Text = "✗ " .. tostring(err):sub(1, 60)
        StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)
    end
    task.delay(3, function()
        StatusLabel.Text = "idle"
        StatusLabel.TextColor3 = Color3.fromRGB(120, 110, 180)
    end)
end

ExecBtn.MouseButton1Click:Connect(function()
